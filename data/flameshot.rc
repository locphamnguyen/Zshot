#pragma code_page(65001) // UTF-8

IDI_ICON1 ICON "img\\app\\zshot.ico"

#include <windows.h>

#define VER_FILEVERSION             FLAMESHOT_VERSION_MAJOR,FLAMESHOT_VERSION_MINOR,FLAMESHOT_VERSION_BUGFIX,FLAMESHOT_VERSION_BUILD
#if defined(__MINGW32__)
// windres drops the quotes of -DFLAMESHOT_VERSION_STRING="...": build the string here
#define ZS_STR_(x) #x
#define ZS_STR(x) ZS_STR_(x)
#define VER_FILEVERSION_STR         ZS_STR(FLAMESHOT_VERSION_MAJOR.FLAMESHOT_VERSION_MINOR.FLAMESHOT_VERSION_BUGFIX)
#else
#define VER_FILEVERSION_STR         FLAMESHOT_VERSION_STRING
#endif

#define VER_PRODUCTVERSION          FLAMESHOT_VERSION_MAJOR,FLAMESHOT_VERSION_MINOR,FLAMESHOT_VERSION_BUGFIX,FLAMESHOT_VERSION_BUILD
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR

#ifndef DEBUG
#define VER_DEBUG                   0
#else
#define VER_DEBUG                   VS_FF_DEBUG
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VER_DEBUG
FILEFLAGS       VER_DEBUG
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The flameshot Org."
            VALUE "FileDescription",  "Zshot"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "zshot"
            VALUE "LegalCopyright",   "Copyright (C) 2017-2020 flameshot.org"
            VALUE "OriginalFilename", "zshot.exe"
            VALUE "ProductName",      "Zshot"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0 /* U.S. English (Unicode) */
    END
END
